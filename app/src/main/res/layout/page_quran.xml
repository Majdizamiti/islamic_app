<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Green Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_green"
        android:padding="20dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white"
            android:rotation="180"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="القرآن الكريم"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="114 سورة"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:alpha="0.8" />
        </LinearLayout>

        <EditText
            android:id="@+id/etSearchSurah"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_below="@id/ivBack"
            android:layout_marginTop="20dp"
            android:background="@drawable/ayah_background_pattern"
            android:backgroundTint="#20FFFFFF"
            android:drawableEnd="@android:drawable/ic_menu_search"
            android:drawablePadding="12dp"
            android:gravity="end|center_vertical"
            android:hint="ابحث عن سورة..."
            android:paddingHorizontal="16dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- Scrollable Content Section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:weightSum="3">
                <TextView
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:background="@drawable/ayah_background_pattern" android:backgroundTint="@color/gray_light"
                    android:gravity="center" android:text="28 مدنية" android:textColor="@color/dark_text" />
                <TextView
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginHorizontal="8dp"
                    android:background="@drawable/ayah_background_pattern" android:backgroundTint="@color/gray_light"
                    android:gravity="center" android:text="86 مكية" android:textColor="@color/dark_text" />
                <TextView
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:background="@drawable/ayah_background_pattern" android:backgroundTint="@color/dark_green"
                    android:gravity="center" android:text="الكل" android:textColor="@color/white" />
            </LinearLayout>

            <!-- Summary Cards Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:weightSum="3">
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1"
                    app:cardBackgroundColor="@color/quran_card_green" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/dark_green"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="604" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/dark_green"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="صفحة" android:textSize="12sp" android:textColor="@color/text_hint"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" android:layout_marginHorizontal="8dp"
                    app:cardBackgroundColor="@color/quran_card_yellow" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/btn_star_big_on" app:tint="@color/gold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6236" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/gold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="آية" android:textSize="12sp" android:textColor="@color/text_hint"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1"
                    app:cardBackgroundColor="@color/quran_card_green" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="@color/dark_green"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="114" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/dark_green"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سورة" android:textSize="12sp" android:textColor="@color/text_hint"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Efficient List Container -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSurahs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_surah" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>